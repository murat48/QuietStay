# Copy to .env.local and fill in. .env.local is gitignored.
#
# Generate the keys with the Stellar CLI:
#   stellar keys generate qs-issuer --fund --network testnet
#   stellar keys generate qs-sep10-server            # never needs funding
#   stellar keys show qs-issuer                      # prints the S... secret
#
# See docs/SETUP.md for the full walkthrough.

# --- the deployed contract -------------------------------------------------
# The reference deployment. Redeploy your own with scripts/deploy.sh if you like.
QUIETSTAY_CONTRACT_ID=CC3URR3UXTKYPJVU7HWEUTKXPHFEPLZ6X6EXMLYLXY2QDRMQTKMLMF7M
NEXT_PUBLIC_QUIETSTAY_CONTRACT_ID=CC3URR3UXTKYPJVU7HWEUTKXPHFEPLZ6X6EXMLYLXY2QDRMQTKMLMF7M

# --- server-side secrets ---------------------------------------------------
# The issuer's signing key. It signs attestations and co-signs transfer
# approvals. It CANNOT move, freeze, or burn a right anyone holds — that is
# enforced by the contract, not by keeping this key safe. See docs/DESIGN.md.
#
# It also cannot be ROTATED: the contract fixed its issuer at construction, so a
# key that leaks is leaked for the life of the deployment. Leave this unset on
# any host you do not control and the app runs read-only — the registry,
# verification and the request flow all work without it, and the routes that
# need it answer 503 saying so. See docs/VERCEL.md.
QUIETSTAY_ISSUER_SECRET=S...

# SEP-10 challenge signing key. Never submitted in a transaction, so it does not
# need to be a funded account.
QUIETSTAY_SEP10_SERVER_SECRET=S...

# Signs the session token issued after a successful SEP-10 handshake.
# Any random string of 32+ characters.
QUIETSTAY_SESSION_SECRET=change-me-to-32-or-more-random-characters

# --- SEP-10 domains --------------------------------------------------------
NEXT_PUBLIC_HOME_DOMAIN=localhost:3000
NEXT_PUBLIC_WEB_AUTH_DOMAIN=localhost:3000

# --- demo identities (scripts only) ---------------------------------------
# Used by `npm run seed` and `npm run evidence` to play the parts of owner,
# renter, and buyer on testnet. The web app never reads these; it signs with
# Freighter.
DEMO_OWNER_SECRET=S...
DEMO_RENTER_SECRET=S...
DEMO_BUYER_SECRET=S...

# --- where the app may write ----------------------------------------------
# Defaults to the working directory, which is right for development and for any
# host with a disk that persists. Attestations that shipped with the build are
# read from the working directory either way, so pointing this somewhere empty
# does not hide them.
# QUIETSTAY_DATA_DIR=/var/lib/quietstay

# --- a store, for hosts with no disk --------------------------------------
# A serverless host serves the app from a read-only filesystem, so a week issued
# from the deployed app has nowhere to put its attestation and a request has
# nowhere to be kept. Set these and both work; leave them unset and the app uses
# the filesystem, which is what you want locally.
#
# Upstash injects these names; Vercel's own integration used to use KV_REST_API_URL
# and KV_REST_API_TOKEN, and either pair is accepted. See docs/VERCEL.md.
#
# Nothing here is authoritative — the contract is. A store that vanished would
# cost the registry its verification badges and its pending asks, and cost nobody
# their property.
# UPSTASH_REDIS_REST_URL=https://....upstash.io
# UPSTASH_REDIS_REST_TOKEN=...

# --- optional overrides ----------------------------------------------------
# STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
