{
  "name": "quietstay",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "QuietStay Phase 1 — a marketplace for tokenized vacation usage rights on Stellar testnet",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "commit-record": "tsx scripts/commit-record.ts",
    "attest": "tsx scripts/attest.ts",
    "describe": "tsx scripts/describe.ts",
    "verify-record": "tsx scripts/verify-record.ts",
    "check-privacy": "tsx scripts/check-privacy.ts",
    "e2e": "tsx scripts/e2e.ts",
    "evidence-doc": "tsx scripts/write-evidence-doc.ts",
    "zk:check-poseidon": "tsx scripts/zk/check-poseidon.ts",
    "zk:compile": "circom circuits/gpl/transfer.circom --r1cs --wasm --sym -p bls12381 -o circuits/build",
    "zk:test": "tsx --test circuits/test/*.test.ts",
    "zk:setup": "bash scripts/setup-dev.sh",
    "zk:secret": "tsx scripts/zk/secret.ts",
    "zk:prove": "tsx scripts/prove.ts",
    "zk:encode-vk": "tsx scripts/zk/encode-vk.ts",
    "zk:measure": "tsx scripts/zk/measure.ts",
    "zk:check-bundle": "tsx scripts/zk/check-bundle.ts",
    "zk:test-fixtures": "tsx scripts/zk/make-test-fixtures.ts",
    "zk:commitment": "tsx scripts/zk/commitment.ts",
    "zk:submit": "tsx scripts/zk/submit-transfer.ts",
    "zk:reissue": "tsx scripts/zk/reissue-inventory.ts",
    "zk:evidence": "tsx scripts/zk/produce-evidence.ts"
  },
  "dependencies": {
    "@creit.tech/stellar-wallets-kit": "^2.5.0",
    "@stellar/stellar-sdk": "^16.2.0",
    "canonicalize": "^2.1.0",
    "jose": "^6.1.0",
    "next": "^16.3.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "circomlib": "2.0.5",
    "ffjavascript": "0.2.63",
    "snarkjs": "0.7.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
